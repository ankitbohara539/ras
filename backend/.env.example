APP_NAME=Sahayatri API
APP_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
# Used by SQLAlchemy and Alembic for all application tables.
DATABASE_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Supabase Dashboard -> Project Settings -> API.
# The service-role key bypasses Row Level Security. Server-side only -- never
# put it in a VITE_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=ticket-photos

# Duplicate-detection blend. These four must sum to 1.0.
DEDUPE_WEIGHT_CATEGORY=0.35
DEDUPE_WEIGHT_TEXT=0.30
DEDUPE_WEIGHT_IMAGE=0.20
DEDUPE_WEIGHT_GEO=0.15

# Below this score a candidate is not even recorded as a suggestion.
DEDUPE_MIN_SCORE=0.45
DEDUPE_MAX_CANDIDATES=5

# Nearby citizen confirmations needed for the community-verified badge.
CORROBORATION_THRESHOLD=3

# Hazard map: safer-route suggestions (walking, wheelchair, vehicle).
# Free key at https://openrouteservice.org/dev/#/signup (about 2,000 routes/day).
# Without it the hazard map still shows hazards; routes report "not set up".
OPENROUTESERVICE_API_KEY=

# Dashboard "briefing" button: an AI-written line summarising your reports
# and ward (citizens), or your ward's open-report load and queues (officers).
# Our own model -- an open-weight instruct model hosted through Hugging
# Face's router, not a third-party AI product's API. Free access token at
# https://huggingface.co/settings/tokens.
# Free credit is small; specific model+provider pairings are priced at $0
# and change over time -- see huggingface.co/docs/inference-providers/pricing
# and swap HUGGINGFACE_MODEL in app/core/config.py if the default stops
# being free for you.
# Without it the button still works, with a templated line built from the
# same numbers instead of AI-written prose.
HUGGINGFACE_API_KEY=
