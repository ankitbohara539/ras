APP_NAME=CivicGrid API
APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
API_PREFIX=/api/v1
DATABASE_URL=mysql+asyncmy://civicgrid:civicgrid@127.0.0.1:3306/civicgrid
JWT_SECRET=replace-with-an-independent-32-character-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=CivicGrid
SMTP_REPLY_TO=
# starttls (usually port 587), tls (usually port 465), or none (local test server only)
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15
REDIS_URL=
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CivicGrid-Kathmandu/0.3
# Required for public Nominatim in staging/production: a real email or project URL
NOMINATIM_CONTACT=
GEOCODING_COUNTRY_CODES=np
# Kathmandu Metropolitan City bias: left,top,right,bottom
GEOCODING_VIEWBOX=85.2630,27.7580,85.3860,27.6580
GEOCODING_BOUNDED=true
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_PATH=uploads
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
