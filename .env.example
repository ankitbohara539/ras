# Frontend (copy to frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap contributors</a>

# Backend (copy to backend/.env)
APP_NAME=CivicGrid API
APP_ENV=development
APP_SECRET=replace-with-at-least-32-random-characters
API_PREFIX=/api/v1
DATABASE_URL=mysql+asyncmy://civicgrid:civicgrid@127.0.0.1:3306/civicgrid
JWT_SECRET=replace-with-an-independent-32-character-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=CivicGrid
SMTP_REPLY_TO=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=15
REDIS_URL=
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CivicGrid/0.2
NOMINATIM_CONTACT=
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_PATH=uploads
