# FastAPI base URL. Leave blank in local development to use Vite's /api proxy.
VITE_API_URL=

# The browser never talks to Supabase directly -- it goes through FastAPI, so
# authorization lives in one place. No Supabase keys belong in this file.

# Where the dev server proxies /api. Only change this if port 8000 is stuck
# with a stale backend process (Windows allows two binds on one port).
VITE_API_PROXY_TARGET=http://localhost:8001
